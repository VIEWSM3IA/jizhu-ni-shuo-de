.top-row { display: flex; justify-content: space-between; align-items: center; }.menu { width: 72rpx; height: 72rpx; line-height: 72rpx; border-radius: 50%; background: transparent; font-size: 30rpx; margin: 0; padding: 0; }
.creator { font-size: 30rpx; color: #575c64; margin: 44rpx 0 18rpx; }.statement { font-size: 58rpx; line-height: 1.25; font-weight: 750; letter-spacing: -1rpx; word-break: break-all; }.open-time { color: #727780; font-size: 27rpx; margin-top: 42rpx; }.divider { height: 1rpx; background: #e2e3e7; margin: 52rpx 0 42rpx; }.count { font-size: 31rpx; font-weight: 700; }.hint { font-size: 26rpx; line-height: 1.55; color: #8c9097; margin-top: 14rpx; }
.sealed { display: flex; gap: 24rpx; background: #fff; padding: 32rpx; border-radius: 36rpx; margin-top: 42rpx; }.seal-icon { width: 68rpx; height: 68rpx; line-height: 68rpx; text-align: center; border-radius: 24rpx; background: #eef0f4; color: #555b65; font-weight: 800; }.sealed-title { font-weight: 750; font-size: 30rpx; }.due-title { font-size: 50rpx; line-height: 1.25; font-weight: 750; }
.results { margin-top: 24rpx; background: #fff; border-radius: 32rpx; overflow: hidden; }.result { padding: 26rpx 28rpx; display: flex; align-items: center; }.result + .result { border-top: 1rpx solid rgba(24,25,29,.07); }.avatar { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; border-radius: 22rpx; background: #eef0f4; font-size: 25rpx; font-weight: 700; margin-right: 22rpx; }.person { font-size: 29rpx; font-weight: 700; }.badge { font-size: 21rpx; color: #9a9ea5; font-weight: 400; }.stance { margin-left: auto; padding: 12rpx 18rpx; border-radius: 18rpx; font-size: 26rpx; font-weight: 700; }.stance.agree { background: #edf3ff; color: #2e67c7; }.stance.disagree { background: #fff0ee; color: #b64e45; }
.count { font-size: 36rpx; }
.reminder { margin-top: 36rpx; padding: 28rpx 30rpx; border-radius: 30rpx; background: #f0f3f6; }
.reminder-btn,.reminder-retry,.reminder-cancel { margin: 0; padding: 0; background: transparent; line-height: 1.4; text-align: left; }
.reminder-btn::after,.reminder-retry::after,.reminder-cancel::after { border: 0; }
.reminder-btn { width: auto; font-size: 28rpx; font-weight: 600; color: #555a62; }
.reminder-help { margin-top: 10rpx; font-size: 23rpx; line-height: 1.5; color: #777f89; }
.reminder-pending { font-size: 25rpx; color: #747981; }
.reminder-retry { width: auto; margin-top: 12rpx; font-size: 25rpx; font-weight: 600; color: #18191d; }
.reminder-armed { font-size: 27rpx; font-weight: 650; color: #26724e; }
.reminder-cancel { width: auto; margin-top: 10rpx; font-size: 23rpx; color: #8b8f96; }
.choices { display: flex; gap: 18rpx; }.choices button { flex: 1; margin: 0; height: 108rpx; line-height: 108rpx; border-radius: 36rpx; background: #fff; font-size: 30rpx; font-weight: 750; }.choices button[disabled] { opacity: .45; }.home-link { text-align: center; color: #777; font-size: 25rpx; padding-top: 20rpx; }.message { padding: 100rpx 20rpx; text-align: center; }.empty-icon { font-size: 72rpx; }.empty-title { font-size: 39rpx; font-weight: 700; margin: 24rpx 0 12rpx; }.message .secondary { margin-top: 40rpx; }.skeleton view { height: 100rpx; background: #e9eaed; border-radius: 30rpx; margin: 18rpx 0; }
