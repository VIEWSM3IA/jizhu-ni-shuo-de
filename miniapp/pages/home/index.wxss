.hero { margin: 12rpx 0 26rpx; }.hero-title { font-size: 56rpx; line-height: 1.14; font-weight: 750; letter-spacing: -1rpx; }.hero-sub { font-size: 29rpx; color: #747981; margin-top: 10rpx; }
.filters { white-space: nowrap; margin-bottom: 24rpx; }.filter-row { display: flex; gap: 10rpx; }.chip { flex-shrink: 0; padding: 13rpx 24rpx; border-radius: 100rpx; font-size: 27rpx; color: #6f737b; }.chip.active { background: #e7e8eb; color: #17181b; font-weight: 700; }
.cards { display: flex; flex-direction: column; gap: 18rpx; }.card { background: #fff; border: 1rpx solid rgba(24,25,29,.07); border-radius: 36rpx; padding: 28rpx 30rpx; box-shadow: 0 4rpx 22rpx rgba(0,0,0,.025); }.card-head { display: flex; align-items: center; justify-content: space-between; }.role { font-size: 23rpx; color: #9a9ea5; }.statement { font-size: 36rpx; line-height: 1.35; font-weight: 700; margin: 22rpx 0 24rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }.meta { font-size: 25rpx; color: #747981; }
.opened-hint { margin-top: 17rpx; color: #747981; font-size: 24rpx; }
.message { padding: 110rpx 22rpx; text-align: center; font-size: 28rpx; }.empty-icon { font-size: 62rpx; }.empty-title { font-size: 38rpx; font-weight: 700; margin: 24rpx 0 10rpx; }.empty-button { margin-top: 36rpx; }.skeleton view { height: 190rpx; background: #e9eaed; border-radius: 42rpx; margin: 18rpx 0; }.more { background: transparent; color: #777; font-size: 26rpx; }
.due-banner { display: flex; align-items: center; justify-content: space-between; margin: 16rpx 0 22rpx; padding: 22rpx 26rpx; border-radius: 24rpx; background: #fff1db; color: #72501f; font-size: 27rpx; font-weight: 650; }
.due-banner-arrow { margin-left: 16rpx; font-size: 25rpx; opacity: .75; }
.upcoming-tag { margin-left: 12rpx; padding: 5rpx 12rpx; border-radius: 999rpx; background: #f1f2f4; color: #747981; font-size: 20rpx; font-weight: 550; }
